# Copy this stanza into the local ~/.codex/config.toml after replacing only the
# SSH alias and remote plugin path. The server runs over SSH stdio; do not open
# an MCP TCP port on the remote host.
[mcp_servers.mnogovid_system_prod_audit]
command = "ssh"
args = [
  "-T",
  "-o", "BatchMode=yes",
  "-o", "ClearAllForwardings=yes",
  "-o", "ForwardAgent=no",
  "-o", "StrictHostKeyChecking=yes",
  "prod-audit",
  "/usr/bin/python3",
  "/opt/mnogovid-system-scanner/scripts/system_mcp.py"
]
