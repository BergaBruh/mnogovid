{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mnogovid-system-scanner": {
      "type": "local",
      "command": ["python3", "./scripts/system_mcp.py"],
      "cwd": "/absolute/path/to/mnogovid-system-scanner",
      "enabled": true,
      "timeout": 10000
    }
  },
  "permission": {
    "mnogovid-system-scanner_*": "ask"
  }
}
